---
layout: default
---
{% comment %}
  Local override of the al_folio_core `page` layout. The upstream copy parses
  `{% bibliography %}` and the al_comments partial unconditionally, which fails
  as soon as the unused jekyll-scholar / al_comments plugins are removed from
  this site. Neither feature is used here.
{% endcomment %}
{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="post">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    <p class="post-description">{{ page.description }}</p>
  </header>

  <article>
    {{ content }}
  </article>
</div>
