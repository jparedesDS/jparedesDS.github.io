---
layout: default
---
{% assign active_lang = site.active_lang | default: site.lang | default: 'en' %}
{% assign strings = site.data[active_lang].strings %}
{% assign year = page.date | date: '%Y' %}
{% assign is_blog_post = false %}
{% if page.collection == 'posts' %}{% assign is_blog_post = true %}{% endif %}

{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="post">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    <p class="post-meta">
      {{ strings.post.created_on }} {{ page.date | date: strings.blog.date_format }}
      {% if page.author %}{{ strings.post.by }} {{ page.author }}{% endif %}
      {% assign last_date = page.last_modified_at | default: page.last_updated %}
      {% if last_date %}, {{ strings.post.last_updated_on }} {{ last_date | date: strings.blog.date_format }}{% endif %}
      {% if page.meta %}&middot; {{ page.meta }}{% endif %}
    </p>
    <p class="post-tags">
      {% if is_blog_post %}
        <a href="{{ year | prepend: '/blog/' | append: '/' | relative_url }}"> <i class="fa-solid fa-calendar fa-sm"></i> {{ year }} </a>
      {% else %}
        <i class="fa-solid fa-calendar fa-sm"></i> {{ year }}
      {% endif %}
      {% if page.tags.size > 0 %}
        &nbsp; &middot; &nbsp;
        {% for tag in page.tags %}
          {% if is_blog_post %}
            <a href="{{ tag | slugify | prepend: '/blog/tag/' | append: '/' | relative_url }}"> <i class="fa-solid fa-hashtag fa-sm"></i> {{ tag }}</a>
          {% else %}
            <i class="fa-solid fa-hashtag fa-sm"></i> {{ tag }}
          {% endif %}
          {% unless forloop.last %}&nbsp;{% endunless %}
        {% endfor %}
      {% endif %}

      {% if page.categories.size > 0 %}
        &nbsp; &middot; &nbsp;
        {% for category in page.categories %}
          {% if is_blog_post %}
            <a href="{{ category | slugify | prepend: '/blog/category/' | append: '/' | relative_url }}"> <i class="fa-solid fa-tag fa-sm"></i> {{ category -}}</a>
          {% else %}
            <i class="fa-solid fa-tag fa-sm"></i> {{ category }}
          {% endif %}
          {% unless forloop.last %}&nbsp;{% endunless %}
        {% endfor %}
      {% endif %}
    </p>
  </header>

  <article class="post-content">
    {% if page.toc and page.toc.beginning %}
      <div id="table-of-contents">
        {% toc %}
      </div>
      <hr>
    {% endif %}
    <div id="markdown-content">
      {{ content }}
    </div>
  </article>

  {% if site.related_blog_posts and site.related_blog_posts.enabled %}
    {% if page.related_posts == null or page.related_posts %}
      {% include related_posts.liquid %}
    {% endif %}
  {% endif %}
</div>
