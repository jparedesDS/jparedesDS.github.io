---
layout: shell
---
{% assign active_lang = site.active_lang | default: site.lang | default: 'en' %}
{% assign strings = site.data[active_lang].strings %}
{% assign home = site.data[active_lang].home %}
{% assign cv = site.data[active_lang].cv.cv %}

<article class="about active" data-page="about" id="about" role="tabpanel">
  <header>
    <h2 class="h2 article-title">{{ home.eyebrow }}</h2>
  </header>

  <section class="about-text">
    {% for paragraph in home.intro %}
      <p>{{ paragraph }}</p>
    {% endfor %}
  </section>

  <section class="service">
    <h3 class="h3 service-title">{{ strings.sections.services }}</h3>

    <ul class="service-list">
      {% for service in home.services %}
        <li class="service-item">
          <div class="service-icon-box">
            {% include icon.liquid name=service.icon %}
          </div>

          <div class="service-content-box">
            <h4 class="h4 service-item-title">{{ service.title }}</h4>
            <p class="service-item-text">{{ service.text }}</p>
          </div>
        </li>
      {% endfor %}
    </ul>
  </section>

  <section class="apps">
    <h3 class="h3 apps-title">{{ strings.sections.apps }}</h3>
    {% include apps-strip.liquid apps=home.apps %}
  </section>

  {% if home.availability %}
    <p class="availability">{{ home.availability }}</p>
  {% endif %}
</article>

<article class="resume" data-page="resume" id="resume" role="tabpanel">
  <header>
    <h2 class="h2 article-title">{{ strings.tabs.resume }}</h2>
  </header>

  <section class="timeline">
    <div class="title-wrapper">
      <div class="icon-box">{% include icon.liquid name="code" %}</div>
      <h3 class="h3">{{ strings.cv.sections.Experience }}</h3>
    </div>

    <ol class="timeline-list">
      {% for job in cv.sections.Experience %}
        <li class="timeline-item">
          <h4 class="h4 timeline-item-title">{{ job.position }}</h4>
          <span>{{ job.start_date }} — {{ job.end_date }}</span>
          <p class="timeline-text">{{ job.company }}{% if job.location %} · {{ job.location }}{% endif %}</p>
          {% if job.highlights %}
            <ul class="timeline-highlights">
              {% for point in job.highlights %}
                <li>{{ point }}</li>
              {% endfor %}
            </ul>
          {% endif %}
        </li>
      {% endfor %}
    </ol>
  </section>

  <section class="timeline">
    <div class="title-wrapper">
      <div class="icon-box">{% include icon.liquid name="product" %}</div>
      <h3 class="h3">{{ strings.cv.sections.Education }}</h3>
    </div>

    <ol class="timeline-list">
      {% for study in cv.sections.Education %}
        <li class="timeline-item">
          <h4 class="h4 timeline-item-title">{{ study.institution }}</h4>
          <span>{{ study.start_date }} — {{ study.end_date }}</span>
          <p class="timeline-text">{{ study.studyType }}{% if study.area %} · {{ study.area }}{% endif %}</p>
          {% if study.highlights %}
            <ul class="timeline-highlights">
              {% for point in study.highlights %}
                <li>{{ point }}</li>
              {% endfor %}
            </ul>
          {% endif %}
        </li>
      {% endfor %}
    </ol>
  </section>

  <section class="skill">
    <h3 class="h3 skills-title">{{ strings.cv.sections.Skills }}</h3>

    <ul class="skills-list content-card">
      {% for group in cv.sections.Skills %}
        {% include skill-chips.liquid group=group %}
      {% endfor %}
    </ul>
  </section>

  <a class="download-cv" {% static_href %}href="{{ '/assets/pdf/resume.pdf' | relative_url }}"{% endstatic_href %} download>
    {% include icon.liquid name="download" %}
    {{ strings.cv.download_pdf }}
  </a>
</article>

<article class="portfolio" data-page="portfolio" id="portfolio" role="tabpanel">
  <header>
    <h2 class="h2 article-title">{{ strings.tabs.portfolio }}</h2>
  </header>

  <section class="projects">
    {% include project-filter.liquid %}

    <ul class="project-list">
      {% assign projects = site.projects | sort: "importance" %}
      {% for project in projects %}
        {% include project-card.liquid project=project %}
      {% endfor %}
    </ul>
  </section>
</article>

<article class="blog" data-page="blog" id="blog" role="tabpanel">
  <header>
    <h2 class="h2 article-title">{{ strings.tabs.blog }}</h2>
  </header>

  <section class="blog-posts">
    {% include blog-preview.liquid %}
  </section>
</article>

<article class="contact" data-page="contact" id="contact" role="tabpanel">
  <header>
    <h2 class="h2 article-title">{{ strings.sections.contact }}</h2>
  </header>

  {% if home.availability %}
    <p class="contact-intro">{{ home.availability }}</p>
  {% endif %}

  {% include contact-links.liquid %}
</article>
