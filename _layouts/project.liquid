---
layout: page
---
{% comment %}
  Basic project page layout. Task 8 refines the markup and styles.
{% endcomment %}
{% assign active_lang = site.active_lang | default: site.lang | default: 'en' %}
{% assign strings = site.data[active_lang].strings %}
<div class="project-page">
  <div class="project-meta">
    <span class="project-category">{{ strings.project_categories[page.category] | default: page.category }}</span>
    {% if page.private %}
      <span class="project-private">{{ strings.projects.private_repository }}</span>
    {% endif %}
    {% if page.rendered_lang and page.rendered_lang != active_lang %}
      <span class="project-lang-badge">EN</span>
    {% endif %}
  </div>
  {% if page.img %}
    <div class="project-hero-image">
      {% include figure.liquid path=page.img alt=page.img_alt %}
    </div>
  {% endif %}
  {% if page.links %}
    <div class="project-links">
      {% include project-links.liquid links=page.links %}
    </div>
  {% endif %}
  {% if page.tutorial %}
    <p class="project-tutorial">
      <a href="{{ page.tutorial | relative_url }}">{{ strings.projects.read_tutorial }}</a>
    </p>
  {% endif %}
  {{ content }}
</div>
