<!doctype html>
<html lang="{{ site.active_lang | default: site.lang }}">
  <head>
    {% include head.liquid %}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <main>
      {% include sidebar.liquid %}

      <div class="main-content">
        {% assign nav_mode = "links" %}
        {% if page.layout == "home" %}{% assign nav_mode = "tabs" %}{% endif %}
        {% include navbar.liquid mode=nav_mode %}

        {{ content }}
      </div>
    </main>

    <script src="{{ '/assets/js/script.js' | relative_url }}" defer></script>
  </body>
</html>
