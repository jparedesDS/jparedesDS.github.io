---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { models, projects } from "../../data/projects";
import type { ProjectLink } from "../../data/projects";

type ArchiveItem = {
  slug: string;
  title: string;
  year: string;
  kind: "project" | "model";
  meta: string;
  href?: string;
  links: ProjectLink[];
  private?: boolean;
};

const categoryLabels = {
  "ai-vision": "AI & Computer Vision",
  "data-automation": "Data & Automation",
  products: "Products & Tools",
  esports: "Esports & Content",
} as const;

const items: ArchiveItem[] = [
  ...projects.map((project) => ({
    slug: project.slug,
    title: project.title,
    year: project.year,
    kind: "project" as const,
    meta: categoryLabels[project.category],
    href: project.href,
    links: project.private ? [] : project.links,
    private: project.private,
  })),
  ...models.map((model) => ({
    slug: model.slug,
    title: model.name,
    year: model.year,
    kind: "model" as const,
    meta: `Model · ${model.version}`,
    links: model.links,
  })),
];

const sorted = [...items].sort(
  (a, b) => Number(b.year) - Number(a.year) || a.title.localeCompare(b.title, "en"),
);

const years = [...new Set(sorted.map((item) => item.year))];

const groups = years.map((year) => ({
  year,
  items: sorted.filter((item) => item.year === year),
}));
---

<BaseLayout
  title="Archive — Jose Paredes"
  description="Every project and model release by Jose Paredes, newest first."
>
  <div class="work-archive">
    <header class="page-header">
      <h1>Archive</h1>
    </header>

    {
      groups.map((group) => (
        <section class="archive-year">
          <h2 class="archive-year-header" id={group.year}>
            <a class="archive-header-link" href={`#${group.year}`}>
              {group.year}
            </a>
            <sup class="archive-count">&nbsp;{group.items.length}</sup>
          </h2>
          <div class="archive-month">
            <h3 class="archive-month-header" id={`${group.year}-all`}>
              <a class="archive-header-link" href={`#${group.year}-all`}>
                All year
              </a>
              <sup class="archive-count">&nbsp;{group.items.length}</sup>
            </h3>
            <div class="archive-posts">
              {group.items.map((item) => (
                <article class="archive-entry" data-kind={item.kind} data-slug={item.slug}>
                  <h3 class="archive-entry-title entry-hint-parent">{item.title}</h3>
                  <div class="archive-meta">
                    Year: {item.year}&nbsp;|&nbsp;{item.meta}
                    {item.links.length > 0 && (
                      <>
                        {" "}
                        &nbsp;|&nbsp;{" "}
                        {item.links.map((link, i) => (
                          <>
                            <a href={link.url} rel={link.external ? "noopener" : undefined}>
                              {link.label}
                            </a>
                            {i < item.links.length - 1 ? " · " : ""}
                          </>
                        ))}
                      </>
                    )}
                    {item.private && (
                      <>
                        {" "}
                        &nbsp;|&nbsp; <span>Private project</span>
                      </>
                    )}
                  </div>
                  {item.href && (
                    <a class="entry-link" aria-label={`Open ${item.title}`} href={item.href}></a>
                  )}
                </article>
              ))}
            </div>
          </div>
        </section>
      ))
    }
  </div>
</BaseLayout>
