---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { models, projects } from "../../data/projects";
import type { ProjectLink } from "../../data/projects";

type ArchiveItem = {
  slug: string;
  title: string;
  year: string;
  kind: "project" | "model";
  meta: string;
  href?: string;
  links: ProjectLink[];
  private?: boolean;
};

const categoryLabels = {
  "ai-vision": "AI & Computer Vision",
  "data-automation": "Data & Automation",
  products: "Products & Tools",
  esports: "Esports & Content",
} as const;

const items: ArchiveItem[] = [
  ...projects.map((project) => ({
    slug: project.slug,
    title: project.title,
    year: project.year,
    kind: "project" as const,
    meta: categoryLabels[project.category],
    href: project.href,
    links: project.private ? [] : project.links,
    private: project.private,
  })),
  ...models.map((model) => ({
    slug: model.slug,
    title: model.name,
    year: model.year,
    kind: "model" as const,
    meta: `Model · ${model.version}`,
    links: model.links,
  })),
];

const sorted = [...items].sort(
  (a, b) => Number(b.year) - Number(a.year) || a.title.localeCompare(b.title, "en"),
);

const years = [...new Set(sorted.map((item) => item.year))];

const groups = years.map((year) => ({
  year,
  items: sorted.filter((item) => item.year === year),
}));
---

<BaseLayout
  title="Work archive — Jose Paredes"
  description="Every project and model release by Jose Paredes, newest first."
>
  <div class="page">
    <header class="archive-hero">
      <p class="section-kicker">01 / Archive</p>
      <h1>Archive</h1>
      <p class="archive-lede">
        {items.length} items — {projects.length} projects and {models.length} model releases, newest first.
      </p>
      <a class="archive-back" href="/">← Back to home</a>
    </header>

    {
      groups.map((group) => (
        <section class="archive-year">
          <h2 class="archive-year-head">
            {group.year} <span>{group.items.length}</span>
          </h2>
          {group.items.map((item) => (
            <article class="archive-entry" data-kind={item.kind} data-slug={item.slug}>
              <div class="archive-entry-main">
                <h3>{item.href ? <a href={item.href}>{item.title}</a> : item.title}</h3>
                <p class="archive-entry-meta">{item.meta}</p>
              </div>
              <div class="archive-entry-links">
                {item.private && <span class="archive-private">Private project</span>}
                {item.links.map((link) => (
                  <a href={link.url} rel={link.external ? "noopener" : undefined}>
                    {link.label}
                    <span aria-hidden="true">{link.external ? " ↗" : " →"}</span>
                  </a>
                ))}
              </div>
            </article>
          ))}
        </section>
      ))
    }

    <p class="archive-foot"><a href="/">← Back to home</a></p>
  </div>
</BaseLayout>
