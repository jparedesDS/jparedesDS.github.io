---
import type { Project } from "../data/projects";

interface Props {
  project: Project;
}

const { project } = Astro.props;

const categoryLabels: Record<Project["category"], string> = {
  "ai-vision": "AI & Vision",
  "data-automation": "Data & Automation",
  products: "Product",
  esports: "Esports",
};

const categoryLabel = categoryLabels[project.category];
const initial = project.title.slice(0, 1).toUpperCase();

const web = project.links.find(
  (link) => /website|web/i.test(link.label) && /^https?:/.test(link.url),
);
const code = project.links.find((link) => /code|github/i.test(link.label));
const primary = project.href ?? web?.url ?? project.links[0]?.url;
const primaryExternal = primary?.startsWith("http") ?? false;
const codeLabel = project.skill ? "Skill" : "Code";
---

<article class="work-card" data-project={project.slug}>
  <div class="work-media" data-project={project.slug}>
    {
      project.image ? (
        primary ? (
          <a
            class="work-media-link"
            href={primary}
            target={primaryExternal ? "_blank" : undefined}
            rel={primaryExternal ? "noreferrer" : undefined}
          >
            <img
              src={project.image}
              alt={project.imageAlt ?? ""}
              width="1200"
              height="675"
              loading="lazy"
            />
          </a>
        ) : (
          <img
            src={project.image}
            alt={project.imageAlt ?? ""}
            width="1200"
            height="675"
            loading="lazy"
          />
        )
      ) : (
        <div class="work-fallback" aria-hidden="true">
          <span class="work-fallback-initial">{initial}</span>
          <span class="work-fallback-category">{categoryLabel}</span>
        </div>
      )
    }
  </div>
  <div class="work-body">
    <div class="work-meta">
      <span>{categoryLabel}</span>
      <span>{project.year}</span>
    </div>
    <h3>
      {
        primary ? (
          <a
            href={primary}
            target={primaryExternal ? "_blank" : undefined}
            rel={primaryExternal ? "noreferrer" : undefined}
          >
            {project.title}
          </a>
        ) : (
          project.title
        )
      }
    </h3>
    <p>{project.summary}</p>
    {
      (web || (code && !project.private)) && (
        <div class="work-links">
          {web && (
            <a href={web.url} target="_blank" rel="noreferrer">
              Web <span aria-hidden="true">↗</span>
            </a>
          )}
          {code && !project.private && (
            <a href={code.url} target="_blank" rel="noreferrer">
              {codeLabel} <span aria-hidden="true">↗</span>
            </a>
          )}
        </div>
      )
    }
  </div>
</article>
