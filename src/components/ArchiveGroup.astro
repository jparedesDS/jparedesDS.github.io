---
import type { Project } from "../data/projects";

interface Props {
  id: "ai-vision" | "data-automation" | "products" | "esports";
  index: string;
  label: string;
  projects: Project[];
}

const { id, index, label, projects } = Astro.props;

const visibleLinks = (project: Project) =>
  project.private
    ? project.links.filter((link) => !link.url.toLowerCase().includes("github.com"))
    : project.links;

const privateLabel = (project: Project) => (project.detail ? "Private source" : "Private project");
---

<section class="archive-section" id={id}>
  <div class="archive-group-head">
    <p class="section-kicker">{index} / Projects</p>
    <h2 set:html={label}></h2>
    <span class="archive-count">{projects.length} projects</span>
  </div>
  <div class="archive-list">
    {
      projects.map((project) => (
        <article
          class="archive-item"
          data-slug={project.slug}
          data-private={project.private ? "true" : undefined}
        >
          <div class="archive-thumb" aria-hidden="true">
            {project.image ? (
              <img src={project.image} alt="" width="112" height="112" loading="lazy" />
            ) : (
              <span class="archive-thumb-initial">{project.title.slice(0, 1).toUpperCase()}</span>
            )}
          </div>
          <div class="archive-body">
            <div class="archive-title-row">
              <h3>
                {project.href ? <a href={project.href}>{project.title}</a> : project.title}
              </h3>
              <span class="archive-year">{project.year}</span>
            </div>
            <p>{project.summary}</p>
            <div class="archive-links">
              {project.private && <span class="archive-private">{privateLabel(project)}</span>}
              {visibleLinks(project).map((link) => (
                <a href={link.url} rel={link.external ? "noopener" : undefined}>
                  {link.label}
                  <span aria-hidden="true">{link.external ? " ↗" : " →"}</span>
                </a>
              ))}
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>
