---
import { site } from "../data/site";
---

<div class="experience">
  {
    site.experience.map((item) => (
      <div class="exp-row">
        <div class="exp-role">
          <h3>{item.role}</h3>
          <p>{item.company}</p>
        </div>
        <p class="exp-text">{item.description}</p>
        <span class="exp-date">{item.period}</span>
      </div>
    ))
  }
</div>
