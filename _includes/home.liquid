{% comment %}
  Bilingual homepage (option A).

  About first, the featured subany.video card, the nine selected projects and
  the latest tutorials. Every string comes from `_data/<lang>/home.yml` and
  `_data/<lang>/strings.yml`; the page itself only decides structure.
{% endcomment %}
{% assign active_lang = site.active_lang | default: site.lang | default: 'en' %}
{% assign strings = site.data[active_lang].strings %}
{% assign home = site.data[active_lang].home %}
{% if home %}
  <div class="home">
    <header class="profile-header" id="about">
      <div class="profile-portrait">
        <img
          src="{{ '/profile.jpg' | relative_url }}"
          alt="{{ home.profile_alt }}"
          width="96"
          height="96"
          loading="eager"
        >
      </div>
      <div class="profile-header-body">
        {% if home.eyebrow %}
          <p class="profile-eyebrow">{{ home.eyebrow }}</p>
        {% endif %}
        <h1 class="profile-name">{{ home.name }}</h1>
        {% if home.role %}
          <p class="profile-role">{{ home.role }}</p>
        {% endif %}
        {% if home.summary %}
          <p class="profile-summary">{{ home.summary }}</p>
        {% endif %}
        {% if home.contact %}
          <nav class="profile-contact" aria-label="{{ home.contact_label }}">
            <ul class="profile-contact-list">
              {% for link in home.contact %}
                {% assign external_link = false %}
                {% if link.url contains '://' or link.url contains 'mailto:' %}
                  {% assign external_link = true %}
                {% endif %}
                <li>
                  <a
                    href="{% if external_link %}{{ link.url }}{% else %}{{ link.url | relative_url }}{% endif %}"
                    {% if external_link %}
                      target="_blank" rel="noopener noreferrer"
                    {% elsif link.url contains '.pdf' %}
                      download
                    {% endif %}
                  >{{ link.label }}</a>
                </li>
              {% endfor %}
            </ul>
          </nav>
        {% endif %}
      </div>
    </header>

    {% if home.featured %}
      {% assign featured_primary = home.featured.links | first %}
      <section class="hero-project" aria-labelledby="featured-project-title">
        <div class="hero-project-copy">
          <p class="hero-project-label">{{ home.featured.label }}</p>
          <h2 id="featured-project-title">{{ home.featured.title }}</h2>
          {% if home.featured.tagline %}
            <p class="hero-project-tagline">{{ home.featured.tagline }}</p>
          {% endif %}
          {% if home.featured.description %}
            <p class="hero-project-description">{{ home.featured.description }}</p>
          {% endif %}
          {% if home.featured.links %}
            <div class="hero-project-actions">
              {% for link in home.featured.links %}
                {% assign external_link = false %}
                {% if link.url contains '://' or link.url contains 'mailto:' %}
                  {% assign external_link = true %}
                {% endif %}
                <a
                  class="button {% if link.style == 'primary' %}button-primary{% else %}button-secondary{% endif %}"
                  href="{% if external_link %}{{ link.url }}{% else %}{{ link.url | relative_url }}{% endif %}"
                  {% if external_link %}
                    target="_blank" rel="noopener noreferrer"
                  {% endif %}
                >{{ link.label }}</a>
              {% endfor %}
            </div>
          {% endif %}
        </div>
        {% if home.featured.image and featured_primary %}
          <a
            class="hero-project-preview"
            href="{% if featured_primary.url contains '://' %}{{ featured_primary.url }}{% else %}{{ featured_primary.url | relative_url }}{% endif %}"
            {% if featured_primary.url contains '://' %}
              target="_blank" rel="noopener noreferrer"
            {% endif %}
            aria-label="{{ home.featured.preview_label }}"
          >
            <img
              class="hero-project-image"
              src="{{ home.featured.image | relative_url }}"
              alt="{{ home.featured.image_alt }}"
              width="1200"
              height="630"
              loading="lazy"
            >
          </a>
        {% endif %}
      </section>
    {% endif %}

    {% if home.selected_projects %}
      <section class="home-projects" id="projects" aria-labelledby="home-projects-title">
        <div class="section-heading">
          <h2 id="home-projects-title">{{ home.projects_title }}</h2>
          <a href="{{ '/projects/' | relative_url }}">{{ home.projects_all_label }}</a>
        </div>
        {% if home.selected_note %}
          <p class="section-note">{{ home.selected_note }}</p>
        {% endif %}
        <ul class="project-list">
          {% for key in home.selected_projects %}
            {% assign project = site.projects | where: 'project_key', key | first %}
            {% if project %}
              <li class="project-list-item">
                <h3 class="project-list-title">
                  <a href="{{ project.url | relative_url }}">{{ project.title }}</a>
                </h3>
                {% if project.description %}
                  <p class="project-list-description">{{ project.description }}</p>
                {% endif %}
                {% if project.links %}
                  <div class="project-list-links">
                    {% include project-links.liquid links=project.links limit=2 %}
                  </div>
                {% endif %}
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      </section>
    {% endif %}

    {% if site.posts.size > 0 %}
      {% assign latest_limit = home.latest_limit | default: 3 %}
      <section class="latest-tutorials" aria-labelledby="latest-tutorials-title">
        <div class="section-heading">
          <h2 id="latest-tutorials-title">{{ home.latest_title }}</h2>
          <a href="{{ '/blog/' | relative_url }}">{{ home.latest_all_label }}</a>
        </div>
        {% if home.latest_note %}
          <p class="section-note">{{ home.latest_note }}</p>
        {% endif %}
        <ul class="tutorial-list">
          {% for post in site.posts limit: latest_limit %}
            {% assign reading_time = post.content | number_of_words | divided_by: 180 | plus: 1 %}
            <li class="tutorial-card">
              <h3 class="tutorial-card-title">
                <a href="{{ post.url | relative_url }}">{{ post.title }}</a>
              </h3>
              <p class="tutorial-card-meta">
                <time datetime="{{ post.date | date_to_xmlschema }}">{{ post.date | date: strings.blog.date_format }}</time>
                <span aria-hidden="true">&middot;</span>
                {{ reading_time }} {{ strings.blog.min_read }}
              </p>
              {% if post.description and post.description != '' %}
                <p class="tutorial-card-description">{{ post.description }}</p>
              {% endif %}
            </li>
          {% endfor %}
        </ul>
      </section>
    {% endif %}
  </div>
{% endif %}
