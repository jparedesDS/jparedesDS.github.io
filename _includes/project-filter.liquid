<ul class="filter-list">
  <li class="filter-item">
    <button class="active" type="button" data-filter="all" data-filter-btn aria-pressed="true">
      {{ strings.projects.all }}
    </button>
  </li>
  {% for category in strings.project_categories %}
    <li class="filter-item">
      <button type="button" data-filter="{{ category[0] }}" data-filter-btn aria-pressed="false">
        {{ category[1] }}
      </button>
    </li>
  {% endfor %}
</ul>

<div class="filter-select-box">
  <button class="filter-select" type="button" data-select aria-expanded="false">
    <div class="select-value" data-select-value>{{ strings.projects.all }}</div>
    <div class="select-icon">{% include icon.liquid name="chevron-down" %}</div>
  </button>

  <ul class="select-list">
    <li class="select-item">
      <button type="button" data-select-item data-value="all">{{ strings.projects.all }}</button>
    </li>
    {% for category in strings.project_categories %}
      <li class="select-item">
        <button type="button" data-select-item data-value="{{ category[0] }}">{{ category[1] }}</button>
      </li>
    {% endfor %}
  </ul>
</div>
