{% if include.links %}
  <ul class="project-links">
    {% for link in include.links %}
      {% assign label = strings.project_links[link.type] | default: link.label | default: link.type %}
      <li>
        {% if link.private or link.url == nil or link.url == "" %}
          <span class="project-link project-link--private">
            {{ label }}
            {% if link.private %}
              <span class="project-link-badge">{{ strings.projects.private_repository }}</span>
            {% endif %}
          </span>
        {% else %}
          {% assign url = link.url %}
          {% assign external = false %}
          {% if url contains "://" or url contains "mailto:" %}
            {% assign external = true %}
          {% endif %}
          {% assign same_host = false %}
          {% if url contains site.url %}
            {% assign same_host = true %}
            {% assign url = url | remove_first: site.url %}
          {% endif %}
          {% if external and same_host == false %}
            <a class="project-link" href="{{ url }}" target="_blank" rel="noopener noreferrer">
              {{ label }}
            </a>
          {% else %}
            <a class="project-link" {% static_href %}href="{{ url | relative_url }}"{% endstatic_href %}>
              {{ label }}
            </a>
          {% endif %}
        {% endif %}
      </li>
    {% endfor %}
  </ul>
{% endif %}
