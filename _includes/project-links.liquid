{% comment %}
  Project links.

  Interface:
    include.links  - array of { type, url, private, note, label }
    include.limit  - optional maximum number of links to render

  Labels come from `strings.project_links[link.type]`; `link.label` is a
  fallback for links without a known type. Private or URL-less links render as
  a non-interactive badge so that private repositories are never exposed.
{% endcomment %}
{% assign active_lang = site.active_lang | default: site.lang | default: 'en' %}
{% assign strings = site.data[active_lang].strings %}
{% if include.links %}
  {% for link in include.links %}
    {% if include.limit and forloop.index > include.limit %}
      {% break %}
    {% endif %}
    {% assign label = strings.project_links[link.type] %}
    {% unless label %}
      {% assign label = link.label | default: link.type %}
    {% endunless %}
    {% if link.private or link.url == nil or link.url == '' %}
      <span class="project-link project-link--private">
        <span class="project-link-label">{{ label }}</span>
        {% if link.private %}
          <span class="project-link-badge">{{ strings.projects.private_repository }}</span>
        {% endif %}
        {% if link.note %}
          <small class="project-link-note">{{ link.note }}</small>
        {% endif %}
      </span>
    {% else %}
      {% assign external_link = false %}
      {% if link.url contains '://' or link.url contains 'mailto:' %}
        {% assign external_link = true %}
      {% endif %}
      <a
        class="project-link"
        {% if external_link %}{% if site.url != '' and link.url contains site.url %}{% static_href %}href="{{ link.url }}"{% endstatic_href %}{% else %}href="{{ link.url }}"{% endif %}{% else %}href="{{ link.url | relative_url }}"{% endif %}
        {% if external_link %}target="_blank" rel="noopener noreferrer"{% endif %}
      >
        {{- label -}}
      </a>
      {%- if link.note %} <small class="project-link-note">{{ link.note }}</small>{% endif %}
    {% endif %}
  {% endfor %}
{% endif %}
