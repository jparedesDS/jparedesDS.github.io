<ul class="apps-list has-scrollbar">
  {% for app in include.apps %}
    {% assign external = false %}
    {% if app.url contains "://" %}{% assign external = true %}{% endif %}
    <li class="app-item">
      <a
        href="{% if external %}{{ app.url }}{% else %}{{ app.url | relative_url }}{% endif %}"
        {% if external %}target="_blank" rel="noopener noreferrer"{% endif %}
      >
        <figure class="app-img">
          <img src="{{ app.image | relative_url }}" alt="{{ app.alt }}" width="120" height="90" loading="lazy">
        </figure>
        <h4 class="app-title">{{ app.name }}</h4>
        <p class="app-text">{{ app.text }}</p>
      </a>
    </li>
  {% endfor %}
</ul>
