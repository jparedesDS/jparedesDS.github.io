{% assign active_lang = site.active_lang | default: site.lang | default: 'en' %}
{% assign strings = site.data[active_lang].strings %}
<nav class="navbar" aria-label="{{ strings.nav_label | default: 'Main navigation' }}">
  {% if include.mode == "tabs" %}
    {% assign items = "about,resume,portfolio,contact" | split: "," %}
    <ul class="navbar-list" role="tablist" aria-label="{{ strings.nav_label | default: 'Main navigation' }}">
      {% for key in items %}
        {% assign label = strings.tabs[key] %}
        <li class="navbar-item" role="presentation">
          <button
            class="navbar-link{% if key == 'about' %} active{% endif %}"
            type="button"
            role="tab"
            data-nav-link
            data-target="{{ key }}"
            aria-controls="{{ key }}"
            aria-selected="{% if key == 'about' %}true{% else %}false{% endif %}"
            tabindex="{% if key == 'about' %}0{% else %}-1{% endif %}"
          >
            {{ label }}
          </button>
        </li>
      {% endfor %}
    </ul>
    <a class="navbar-link navbar-blog" data-nav-link href="{{ '/blog/' | relative_url }}">{{ strings.tabs.blog }}</a>
  {% else %}
    {% assign items = "about,resume,portfolio,blog,contact" | split: "," %}
    <ul class="navbar-list">
      {% for key in items %}
        {% assign label = strings.tabs[key] %}
        <li class="navbar-item">
          {% if key == "blog" %}
            <a class="navbar-link" data-nav-link href="{{ '/blog/' | relative_url }}">{{ label }}</a>
          {% else %}
            <a class="navbar-link" data-nav-link href="{{ '/#' | append: key | relative_url }}">{{ label }}</a>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  {% endif %}
</nav>
