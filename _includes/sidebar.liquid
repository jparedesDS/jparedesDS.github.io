{% assign active_lang = site.active_lang | default: site.lang | default: 'en' %}
{% assign home = site.data[active_lang].home %}
{% assign strings = site.data[active_lang].strings %}
<aside class="sidebar" data-sidebar>
  <div class="sidebar-info">
    <figure class="avatar-box">
      <img
        src="{{ '/profile.jpg' | relative_url }}"
        alt="{{ home.profile_alt | default: home.name }}"
        width="80"
        height="80"
        loading="eager"
      >
    </figure>

    <div class="info-content">
      <h1 class="name">{{ home.name }}</h1>
      <p class="title">{{ home.role }}</p>
    </div>

    <button class="info_more-btn" data-sidebar-btn aria-expanded="false" aria-controls="sidebar-more">
      <span>Show Contacts</span>
      {% include icon.liquid name="chevron-down" %}
    </button>
  </div>

  <div class="sidebar-info_more" id="sidebar-more">
    <div class="separator"></div>

    <ul class="contacts-list">
      {% for link in home.contact %}
        {% assign icon_name = "link" %}
        {% case link.label %}
          {% when "Email" %}{% assign icon_name = "mail" %}
          {% when "CV" %}{% assign icon_name = "download" %}
          {% when "LinkedIn" %}{% assign icon_name = "linkedin" %}
          {% when "GitHub" %}{% assign icon_name = "github" %}
        {% endcase %}
        {% assign link_text = link.label %}
        {% if link.url contains "mailto:" %}
          {% assign link_text = link.url | remove_first: "mailto:" %}
        {% endif %}
        <li class="contact-item">
          <div class="icon-box">{% include icon.liquid name=icon_name %}</div>
          <div class="contact-info">
            <p class="contact-title">{{ link.label }}</p>
            <a class="contact-link" {% static_href %}href="{{ link.url }}"{% endstatic_href %}>{{ link_text }}</a>
          </div>
        </li>
      {% endfor %}
    </ul>

    <div class="separator"></div>

    <div class="sidebar-actions">
      {% include language-switch.liquid %}
      <button
        class="theme-toggle"
        type="button"
        data-theme-toggle
        aria-pressed="false"
        aria-label="{{ strings.theme_toggle | default: 'Change color theme' }}"
      >
        {% include icon.liquid name="sun" %}
        {% include icon.liquid name="moon" %}
      </button>
    </div>
  </div>
</aside>
