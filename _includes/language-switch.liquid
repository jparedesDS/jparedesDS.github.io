{% assign active_lang = site.active_lang | default: site.lang | default: 'en' %}
{% if active_lang == 'es' %}
  <a
    class="lang-switch"
    {% static_href %}href="{{ page.url }}"{% endstatic_href %}
    hreflang="en"
    lang="en"
    aria-label="EN — View this page in English"
  >EN</a>
{% else %}
  {% if page.lang_switch_fallback %}
    {% assign target = '/es' | append: page.lang_switch_fallback %}
  {% else %}
    {% assign target = '/es' | append: page.url %}
  {% endif %}
  <a
    class="lang-switch"
    {% static_href %}href="{{ target }}"{% endstatic_href %}
    hreflang="es"
    lang="es"
    aria-label="ES — Ver esta página en español"
  >ES</a>
{% endif %}
